# =========================
# Telegram
# =========================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# =========================
# Binance Public API
# =========================
BINANCE_FAPI_BASE_URL=https://fapi.binance.com
BINANCE_SPOT_BASE_URL=https://api.binance.com

# =========================
# Binance Private API
# 預設不實盤，不需要填
# =========================
BINANCE_API_KEY=
BINANCE_API_SECRET=

# =========================
# Safety
# =========================
ENABLE_TRADING=false
DRY_RUN=true
MAX_ORDER_NOTIONAL_USDT=100
DEFAULT_ORDER_NOTIONAL_USDT=50
DEFAULT_FUTURES_LEVERAGE=1

# =========================
# Zeabur / DB / UI
# =========================
DB_PATH=/app/data/radar.db
UI_PASSWORD=please_change_me

# =========================
# Scanner
# =========================
SCAN_INTERVAL_SECONDS=600
ALERT_COOLDOWN_SECONDS=14400
REQUEST_CONCURRENCY=8
HTTP_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO

# =========================
# Funding Conditions
# =========================
CURRENT_FUNDING_RATE_THRESHOLD=0.0002
AVG_FUNDING_RATE_THRESHOLD=0.00015
POSITIVE_RATIO_THRESHOLD=0.8
HISTORICAL_FUNDING_LIMIT=21

HIGH_RISK_CURRENT_RATE_THRESHOLD=0.0005
ENABLE_HIGH_RISK_WATCHLIST=true

# =========================
# Basis
# =========================
MAX_ABS_BASIS_RATE=0.0015

# =========================
# Stability
# =========================
MAX_FUNDING_STD_7D=0.0005
MAX_ABS_HISTORICAL_FUNDING_RATE=0.003
RECENT_FUNDING_CHECK_PERIODS=3
RECENT_AVG_MIN_RATIO_TO_7D=0.7
CURRENT_MIN_RATIO_TO_7D=0.6

# =========================
# Cost / Slippage
# =========================
SPOT_TAKER_FEE_RATE=0.001
FUTURES_TAKER_FEE_RATE=0.001
USE_DYNAMIC_SLIPPAGE_COST=true
SLIPPAGE_TEST_NOTIONAL_USDT=10000
MAX_TOTAL_SLIPPAGE_RATE=0.001
ORDER_BOOK_LIMIT=100

# =========================
# Payback
# =========================
MAX_PAYBACK_DAYS=4
STRONG_SIGNAL_PAYBACK_DAYS=2

# =========================
# Liquidity
# =========================
MIN_24H_QUOTE_VOLUME_USDT=10000000
MIN_OPEN_INTEREST_NOTIONAL_USDT=5000000
